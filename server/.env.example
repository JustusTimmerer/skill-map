# Copy this file to server/.env and change the secrets. Git ignores server/.env.
# The values below run the stack on this computer: https://it-skills.localhost:8443 with mailpit for mail.

# Compose profiles: "local" starts mailpit. Remove it on a server with a real SMTP server.
COMPOSE_PROFILES=local

# PostgreSQL. Only the app and the tests reach the database; its port is not published.
# POSTGRES_USER is the admin role: db-setup, the tests and backup.sh use it.
POSTGRES_DB=skillmap
POSTGRES_USER=skillmap
POSTGRES_PASSWORD=change-me-to-a-long-random-value
# The app connects as this role without admin rights. db-setup creates it at each start (README.md, "Database roles").
# Empty: db-setup makes a random password once and keeps it in the volume db_app_password. The app reads it from its
# password file and never gets the password of the admin role. A value here wins, and it must differ from POSTGRES_PASSWORD.
POSTGRES_APP_USER=skillmap_app
POSTGRES_APP_PASSWORD=

# The address of the site, as the browser sees it. Writes must come from this origin (CSRF check).
BASE_URL=https://it-skills.localhost:8443
# Subdomains: a public map of "anna" is also at https://anna.<BASE_DOMAIN>/<slug>. Empty turns them off.
BASE_DOMAIN=it-skills.localhost
# "local" turns off the Secure flag of the session cookie, for plain HTTP without the proxy only.
APP_ENV=production

# The proxy (Caddy). SITE_ADDRESS is the main domain, USER_SITE_ADDRESS the wildcard of the subdomains.
SITE_ADDRESS=it-skills.localhost
USER_SITE_ADDRESS=*.it-skills.localhost
# users.caddy serves the subdomains, none.caddy turns them off.
USER_SITES=users.caddy
# Only with none.caddy: on sends every path of www.<domain> to the main domain with 308. It needs a DNS record for www.
WWW_REDIRECT=off
# internal (local CA), acme (public certificate, no wildcard) or dns (public wildcard certificate).
TLS_MODE=internal
# The image of the proxy. Empty means the Caddy image of compose.yaml. For TLS_MODE=dns, the name of a Caddy image with
# the DNS module of the DNS provider (README.md, "TLS with the DNS challenge").
PROXY_IMAGE=
ACME_EMAIL=
DNS_PROVIDER=
DNS_API_TOKEN=
# 127.0.0.1 keeps the proxy local; 0.0.0.0 on a server. These are IPv4 addresses.
BIND_ADDRESS=127.0.0.1
# Only with compose.ipv6.yaml (README.md, "IPv6"): the IPv6 address of the proxy and the IPv6 subnet of the stack.
# BIND_ADDRESS_V6=::
# NETWORK_SUBNET_V6=fd00:10:213:97::/64
# The ports on the host. Caddy listens on the same ports in its container, HTTPS on TCP and UDP (HTTP/3).
HTTP_PORT=8080
HTTPS_PORT=8443
# The site of stage a with the map page of the server: build it first with npm run build:selfhost.
SITE_ROOT=../dist/selfhost
# The network of the stack, and the fixed address of the proxy that the app trusts for X-Forwarded-For.
NETWORK_SUBNET=10.213.97.0/24
PROXY_IP=10.213.97.10

# Mail. Locally mailpit catches every mail: http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
# The login at the mail server. The app logs in only inside TLS: with SMTP_USER set, SMTP_SECURITY must be starttls or
# tls, or the app does not start. mailpit needs no login.
SMTP_USER=
SMTP_PASSWORD=
# none, starttls or tls. none sends the mails in plain text and allows no login.
SMTP_SECURITY=none
MAIL_FROM=it-skills <no-reply@it-skills.localhost>
MAILPIT_PORT=8025

# Limits. A rate limit is count/seconds. A limit per IP counts an IPv6 client by its /64 network.
# A session ends SESSION_DAYS after the sign-in at the latest, and SESSION_IDLE_DAYS after its last use.
SESSION_DAYS=30
SESSION_IDLE_DAYS=7
MAX_MAPS_PER_OWNER=50
MAX_TEAMS_PER_USER=20
# A handle that a team or an account frees stays blocked for this many days. 0 turns the hold off.
HANDLE_HOLD_DAYS=180
RATE_LIMIT_LOGIN_IP=20/900
RATE_LIMIT_LOGIN_ACCOUNT=10/900
RATE_LIMIT_REGISTER_IP=10/3600
RATE_LIMIT_REGISTER_ACCOUNT=3/3600
RATE_LIMIT_RESET_IP=10/3600
RATE_LIMIT_RESET_ACCOUNT=3/3600
RATE_LIMIT_INVITE_USER=20/3600
RATE_LIMIT_INVITE_EMAIL=3/3600
RATE_LIMIT_PASSWORD_CHECK_IP=600/600
